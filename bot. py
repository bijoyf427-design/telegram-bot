# ৪. গ্রুপ ফিল্টারিং ও AI-এর মতো চ্যাট হ্যান্ডলার
async def group_message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return
        
    chat = update.effective_chat
    message = update.message
    message_text = message.text or message.caption or ""
    text_lower = message_text.lower()

    if chat.type in ["group", "supergroup"]:
        # ক) ফরওয়ার্ড করা মেসেজ ডিলিট ও ওয়ার্নিং
        is_forwarded = bool(message.forward_origin or message.forward_from or message.forward_from_chat)
        if is_forwarded:
            try:
                await message.delete()
                await chat.send_message(f"⚠️ @{message.from_user.username or message.from_user.first_name}, Forwarded messages are strictly prohibited here! 🚫")
                return
            except Exception:
                pass

        # খ) টেক্সটের ভেতর লুকিয়ে থাকা লিংক শনাক্ত, ইনস্ট্যান্ট ডিলিট ও ওয়ার্নিং
        has_link = any(pattern in text_lower for pattern in ["http://", "https://", "t.me/", "www.", ".com", ".net", ".org", ".in", "telegram.me"])
        if has_link:
            try:
                await message.delete()
                await chat.send_message(f"⚠️ Warning @{message.from_user.username or message.from_user.first_name}! Links are not allowed in this group! 🚫")
                return
            except Exception:
                pass

        # গ) AI চ্যাট রেসপন্স (হাই, হ্যালো বা র্যান্ডম লেখায় ফানি ও ইমোজি চ্যাট)
        if message_text and not message_text.startswith('/'):
            ai_replies = [
                "Haan bolo 🥰 Watching you!",
                "Arre kya ho raha hai yahan? 😆",
                "Bolo jaan, listening! ✨ 🙈",
                "Hieeee! Kaise ho aap? 🌺 🤭",
                "Haha, funny speech! 🐒💬",
                "Hu... Tell me something interesting! 🐵💕",
                "Hey there! Got your message 😄",
                "Aha! Mujhe yaad kiya? 🙈💖",
                "Chill karo guys! Riya is here 🥳✨"
            ]
            await message.reply_text(random.choice(ai_replies))
            return

# ৫. মডারেশন ও ফান কমান্ড হ্যান্ডলার
async def kick_user(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.message.reply_to_message:
        try:
            await context.bot.ban_chat_member(update.effective_chat.id, update.message.reply_to_message.from_user.id)
            await context.bot.unban_chat_member(update.effective_chat.id, update.message.reply_to_message.from_user.id)
            await update.message.reply_text("User kicked successfully! 👞")
        except Exception:
            await update.message.reply_text("Please promote me to Admin first! ⚠️")
    else:
        await update.message.reply_text("Reply to a message to kick the user! ⚠️")

